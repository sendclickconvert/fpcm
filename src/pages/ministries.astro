---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetNotified from '../components/GetNotified.astro';
import AlternatingSection from '../components/AlternatingSection.astro';
import { CHURCH, MINISTRIES_LIST } from '../data/site';

const title = `Ministries | ${CHURCH.name}`;
const description = `Ministries at First Presbyterian Church of Montgomery — Bible study, Christian education, Westminster Guild, Men's Fellowship, Town of Montgomery Food Pantry, community outreach, and more.`;
---

<BaseLayout title={title} description={description}>

  <!-- Ministries hero with dual CTAs -->
  <section
    class="relative flex items-center justify-center text-white text-center px-6 min-h-[560px] md:min-h-[640px]"
    style="background-image: linear-gradient(180deg, rgba(38,40,128,0.78) 0%, rgba(38,40,128,0.82) 100%), url('/images/new-here-church.png'); background-size: cover; background-position: center;"
  >
    <div class="relative max-w-3xl mx-auto py-16">
      <h1 class="display-xl text-white mb-10">Ministries</h1>

      <div class="flex flex-wrap items-center justify-center gap-5">
        <a href="/events" class="btn btn-crimson">Explore Events</a>

        <a
          href="https://www.youtube.com/@fpcmontgomery"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 font-mono text-sm tracking-wide text-white hover:opacity-90 transition-opacity"
        >
          <span>View More</span>
          <span class="inline-flex items-center justify-center w-9 h-7 bg-[#FF0000] rounded-md" aria-hidden="true">
            <svg width="14" height="10" viewBox="0 0 24 17" fill="#fff" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.5 2.6c-.3-1-1-1.8-2-2C19.7 0 12 0 12 0S4.3 0 2.5.6c-1 .2-1.7 1-2 2C0 4.4 0 8.5 0 8.5s0 4 .5 5.9c.3 1 1 1.8 2 2C4.3 17 12 17 12 17s7.7 0 9.5-.6c1-.2 1.7-1 2-2 .5-1.8.5-5.9.5-5.9s0-4-.5-5.9zM9.5 12V5l6.5 3.5L9.5 12z"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="triangle-pattern py-16 md:py-20">
    <div class="max-w-container mx-auto px-6 lg:px-8 max-w-3xl text-center">
      <p class="eyebrow mb-3">How we serve</p>
      <h2 class="display-lg mb-5">A Place to Connect, Serve, and Grow</h2>
      <p class="font-mono text-[0.92rem] leading-relaxed text-ink-soft">
        Our ministries reflect the heart of First Presbyterian — to feed, nurture, and provide refuge for those in need. Below are the ways we gather, learn, and serve together throughout the year. There is a place for every age and every season of life.
      </p>
    </div>
  </section>

  <!-- Alternating ministry rows -->
  {MINISTRIES_LIST.map((m, i) => (
    <AlternatingSection
      title={m.title}
      body={m.body}
      image={m.image}
      bg={i % 2 === 0 ? 'cream' : 'cream'}
      align={m.align as 'left' | 'right'}
      primaryCta={{ label: 'Click here for more info', href: `/contact?topic=${m.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` }}
      index={i}
    />
  ))}

  <GetNotified />
</BaseLayout>
