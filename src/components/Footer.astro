---
import { CHURCH, FOOTER } from '../data/site';
const year = new Date().getFullYear();
---

<footer style="background-color: #0d1730;">
  <div class="max-w-container mx-auto px-6 lg:px-8 pt-16 pb-12">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-6">

      <!-- Col 1: Logo + description + contact -->
      <div class="md:col-span-3">
        <!-- Logo -->
        <div class="mb-4">
          <img src="/images/LOGO-1.png" alt="First Presbyterian Church of Montgomery" class="h-12 w-auto" />
        </div>
        <!-- Tagline -->
        <p class="font-mono text-[0.78rem] leading-relaxed text-white/70 mb-5">
          A welcoming Presbyterian (PCUSA) congregation in Orange County, NY since {CHURCH.founded}. All are welcome.
        </p>
        <!-- Contact -->
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-3 font-mono text-[0.76rem] text-white/70">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-0.5 text-white/40"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${CHURCH.phoneLink}`} class="hover:text-white transition-colors">{CHURCH.phone}</a>
          </li>
          <li class="flex items-start gap-3 font-mono text-[0.76rem] text-white/70">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-0.5 text-white/40"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${CHURCH.email}`} class="hover:text-white transition-colors break-all">{CHURCH.email}</a>
          </li>
          <li class="flex items-start gap-3 font-mono text-[0.76rem] text-white/70">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-0.5 text-white/40"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>First Presbyterian Church<br />137 Clinton Street<br />Montgomery, NY 12549</span>
          </li>
        </ul>
      </div>

      <!-- Col 2: Links -->
      <div class="md:col-span-2 md:col-start-5">
        <p class="font-sans text-xs font-bold tracking-[0.15em] uppercase text-white mb-5">Links</p>
        <nav class="flex flex-col gap-2.5" aria-label="Footer links">
          {[...FOOTER.links, ...FOOTER.more].map((link) => (
            <a href={link.href} class="font-mono text-[0.75rem] text-white/65 hover:text-white transition-colors">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Services (Worship times / community) -->
      <div class="md:col-span-2">
        <p class="font-sans text-xs font-bold tracking-[0.15em] uppercase text-white mb-5">Worship</p>
        <ul class="flex flex-col gap-2.5">
          <li class="font-mono text-[0.75rem] text-white/65">Sunday Service</li>
          <li class="font-mono text-[0.75rem] text-white">10:00 AM</li>
          <li class="font-mono text-[0.75rem] text-white/65 mt-2">Office Hours</li>
          <li class="font-mono text-[0.75rem] text-white">Mon – Fri, 9 AM – 1 PM</li>
        </ul>

        <p class="font-sans text-xs font-bold tracking-[0.15em] uppercase text-white mt-7 mb-5">Follow Us</p>
        <div class="flex items-center gap-3 flex-wrap">
          <a href={CHURCH.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-white/60 hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href={CHURCH.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="text-white/60 hover:text-white transition-colors">
            <svg width="20" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2C0 8 0 12 0 12s0 4 .5 5.8a3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 16 24 12 24 12s0-4-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z"/></svg>
          </a>
          <a href={CHURCH.social.twitter} target="_blank" rel="noopener" aria-label="X" class="text-white/60 hover:text-white transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.658l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231L18.244 2.25Z"/></svg>
          </a>
          <a href={CHURCH.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-white/60 hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
          <a href={CHURCH.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-white/60 hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 4: CTA card (right side) -->
      <div class="md:col-span-3 md:col-start-10">
        <div class="bg-white/[0.07] border border-white/10 p-6">
          <p class="font-display text-xl text-white mb-2">Ready to join us?</p>
          <p class="font-mono text-[0.75rem] text-white/65 leading-relaxed mb-5">
            Come worship with us this Sunday — no matter where you are in life, you are welcome here.
          </p>
          <a href="/im-new" class="block text-center font-sans text-[0.78rem] font-bold tracking-[0.08em] uppercase bg-crimson text-white py-3 px-5 hover:bg-crimson-deep transition-colors">
            Plan Your Visit
          </a>
        </div>
      </div>

    </div>

    <!-- Divider + copyright -->
    <div class="border-t border-white/10 mt-12 pt-6 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="font-mono text-[0.65rem] tracking-wider text-white/40">
        © {year} First Presbyterian Church of Montgomery. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <img src="/images/image-1.png" alt="" class="h-8 w-auto opacity-60 hover:opacity-100 transition-opacity" loading="lazy" />
        <img src="/images/village-of-montgomery-picture-1.png" alt="Village of Montgomery" class="h-10 w-auto opacity-60 hover:opacity-100 transition-opacity" loading="lazy" />
      </div>
    </div>

  </div>
</footer>
