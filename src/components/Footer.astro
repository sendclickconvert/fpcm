---
import { CHURCH, FOOTER } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-navy-deep text-white relative overflow-hidden">
  <!-- Subtle steeple/triangle pattern -->
  <div class="absolute inset-0 opacity-[0.07] pointer-events-none triangle-pattern-navy"></div>

  <div class="relative max-w-container mx-auto px-6 lg:px-8 pt-16 pb-8">

    <!-- Centered logo + wordmark -->
    <div class="flex flex-col items-center text-center mb-12">
      <img src="/images/logo-steeple.svg" alt="" width="68" height="68" class="h-16 w-16 mb-3" />
      <div class="leading-tight">
        <div class="font-display text-xl font-medium tracking-[0.14em] text-white">FIRST PRESBYTERIAN</div>
        <div class="font-mono text-[0.65rem] tracking-[0.22em] text-white/70 mt-0.5">CHURCH OF MONTGOMERY</div>
      </div>
    </div>

    <!-- 4 column grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-12">

      <!-- Links -->
      <div>
        <p class="eyebrow-crimson mb-5">Links</p>
        <nav class="flex flex-col gap-3" aria-label="Footer links">
          {FOOTER.links.map((link) => (
            <a href={link.href} class="font-mono text-[0.72rem] uppercase tracking-wider text-white/80 hover:text-white transition-colors">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- More links -->
      <div>
        <p class="eyebrow-crimson mb-5">&nbsp;</p>
        <nav class="flex flex-col gap-3" aria-label="Footer secondary">
          {FOOTER.more.map((link) => (
            <a href={link.href} class="font-mono text-[0.72rem] uppercase tracking-wider text-white/80 hover:text-white transition-colors">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <p class="eyebrow-crimson mb-5">Contact</p>
        <address class="not-italic font-mono text-[0.72rem] leading-relaxed text-white/80 space-y-3">
          <div class="flex items-start gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E76B73" stroke-width="2" class="flex-shrink-0 mt-0.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{CHURCH.shortName}<br />{CHURCH.address.street}<br />{CHURCH.address.city}, {CHURCH.address.region} {CHURCH.address.postalCode}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E76B73" stroke-width="2" class="flex-shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${CHURCH.email}`} class="hover:text-white transition-colors break-all">{CHURCH.email}</a>
          </div>
          <div class="flex items-center gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E76B73" stroke-width="2" class="flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${CHURCH.phoneLink}`} class="hover:text-white transition-colors">{CHURCH.phone}</a>
          </div>
        </address>
      </div>

      <!-- Follow Us -->
      <div>
        <p class="eyebrow-crimson mb-5">Follow Us</p>
        <div class="flex items-center gap-4">
          <a href={CHURCH.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-white/80 hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href={CHURCH.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="text-white/80 hover:text-white transition-colors">
            <svg width="20" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2C0 8 0 12 0 12s0 4 .5 5.8a3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 16 24 12 24 12s0-4-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z"/></svg>
          </a>
          <a href={CHURCH.social.twitter} target="_blank" rel="noopener" aria-label="X" class="text-white/80 hover:text-white transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.658l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231L18.244 2.25Z"/></svg>
          </a>
          <a href={CHURCH.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-white/80 hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
          <a href={CHURCH.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-white/80 hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright + credit row -->
    <div class="border-t border-white/15 pt-6">
      <p class="text-center font-mono text-[0.65rem] tracking-wider text-white/55">
        Copyright © {year} First Presbyterian Church of Montgomery. All rights reserved.
        Website designed and developed by <span class="text-white/80">CRST Web Services, a part of Cornerstone Services, Inc.</span>
      </p>
    </div>
  </div>
</footer>
