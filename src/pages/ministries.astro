---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetNotified from '../components/GetNotified.astro';
import AlternatingSection from '../components/AlternatingSection.astro';
import { CHURCH, MINISTRIES_LIST } from '../data/site';

const title = `Ministries | ${CHURCH.name}`;
const description = `Ministries at First Presbyterian Church of Montgomery — Christian education, Men's Fellowship, Sunday School, family activities, community outreach, food pantry, and senior care.`;

const OUTREACH_HIGHLIGHTS = [
  {
    image: '/images/Rectangle-41.jpg',
    heading: 'Montgomery Food Pantry',
    body: 'Operated quarterly, need has grown 200%',
  },
  {
    image: '/images/Rectangle-42.jpg',
    heading: 'Helped build 11+ homes, hosted Habitat talent show fundraiser',
    body: 'Over 11 homes built and counting, putting faith into action for families in need.',
  },
  {
    image: '/images/Rectangle-44.jpg',
    heading: 'Sunday School Initiatives',
    body: 'Habitat & pantry giving projects, crafts/cards for nursing homes, Souper Bowl Sunday food drive.',
  },
  {
    image: '/images/Rectangle-46.jpg',
    heading: "Deacons' Ministry Updates",
    body: 'Moments for mission during services.',
  },
];
---

<BaseLayout title={title} description={description}>

  <!-- Hero with dual CTAs -->
  <section
    class="relative flex items-center justify-center text-white text-center px-6 min-h-[560px] md:min-h-[640px]"
    style="background-image: linear-gradient(180deg, rgba(38,40,128,0.78) 0%, rgba(38,40,128,0.82) 100%), url('/images/bg-ministries.jpg'); background-size: cover; background-position: center;"
  >
    <div class="relative max-w-3xl mx-auto py-16">
      <h1 class="display-xl text-white mb-10">Ministries</h1>

      <div class="flex flex-wrap items-center justify-center gap-5">
        <a href="/events" class="btn btn-crimson">Explore Events</a>

        <a
          href="https://www.youtube.com/@fpcmontgomery"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 font-mono text-sm tracking-wide text-white hover:opacity-90 transition-opacity"
        >
          <span>View More</span>
          <span class="inline-flex items-center justify-center w-9 h-7 bg-[#FF0000] rounded-md" aria-hidden="true">
            <svg width="14" height="10" viewBox="0 0 24 17" fill="#fff" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.5 2.6c-.3-1-1-1.8-2-2C19.7 0 12 0 12 0S4.3 0 2.5.6c-1 .2-1.7 1-2 2C0 4.4 0 8.5 0 8.5s0 4 .5 5.9c.3 1 1 1.8 2 2C4.3 17 12 17 12 17s7.7 0 9.5-.6c1-.2 1.7-1 2-2 .5-1.8.5-5.9.5-5.9s0-4-.5-5.9zM9.5 12V5l6.5 3.5L9.5 12z"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Alternating ministry rows -->
  {MINISTRIES_LIST.map((m, i) => (
    <AlternatingSection
      title={m.title}
      body={m.body}
      image={m.image}
      bg="cream"
      align={m.align as 'left' | 'right'}
      primaryCta={{ label: 'Learn More Here', href: `/contact?topic=${m.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` }}
      index={i}
    />
  ))}

  <!-- Community Outreach highlights grid -->
  <section class="triangle-pattern-navy bg-navy py-16 md:py-20">
    <div class="max-w-container mx-auto px-6 lg:px-8">
      <h2 class="display-lg text-white mb-10">Community Outreach</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {OUTREACH_HIGHLIGHTS.map((item) => (
          <div class="bg-white/5 border border-white/10 overflow-hidden flex flex-col">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={item.image}
                alt={item.heading}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-4 flex flex-col gap-2 flex-1">
              <h4 class="font-bold text-white text-sm leading-snug">{item.heading}</h4>
              <p class="font-mono text-[0.8rem] text-white/75 leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <GetNotified />
</BaseLayout>
