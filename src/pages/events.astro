---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GetNotified from '../components/GetNotified.astro';
import ContactForm from '../components/ContactForm.astro';
import { CHURCH } from '../data/site';

const title = `Events & Gallery | ${CHURCH.name}`;
const description = 'Upcoming events, calendar, and gallery from First Presbyterian Church of Montgomery.';

const EVENTS = [
  {
    dayNum: '28',
    dayName: 'Sun',
    month: 'JUN',
    title: 'Coffee & Conversation',
    time: 'After worship (11:30 AM)',
    note: 'All are asked to bring a side salad!',
    href: '/contact?topic=coffee-conversation',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/sunday-event.jpg',
    description: '',
  },
  {
    dayNum: '5',
    dayName: 'Sun',
    month: 'JUL',
    title: 'Communion',
    time: 'During worship (11:30 AM)',
    note: '',
    href: '/contact?topic=communion',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/Rectangle-27.jpg',
    description: '',
  },
  {
    dayNum: '12',
    dayName: 'Sun',
    month: 'JUL',
    title: 'Westminster Guild',
    time: 'After worship — Late Lunch & Program',
    note: '2nd Sunday of every month',
    href: '/contact?topic=guild',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/westminster-guild.jpg',
    description: '',
  },
  {
    dayNum: '2',
    dayName: 'Sun',
    month: 'AUG',
    title: 'Communion',
    time: 'During worship (11:30 AM)',
    note: '',
    href: '/contact?topic=communion',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/Rectangle-27.jpg',
    description: '',
  },
  {
    dayNum: '9',
    dayName: 'Sun',
    month: 'AUG',
    title: 'Westminster Guild Meeting',
    time: 'After worship — Lunch with Program',
    note: '',
    href: '/contact?topic=guild',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/westminster-guild.jpg',
    description: '',
  },
  {
    dayNum: '16',
    dayName: 'Sun',
    month: 'AUG',
    title: 'Shape the Next Generation – Volunteer for Sunday School!',
    time: 'Christian Education Meeting — After worship',
    note: 'Make a lasting impact on young hearts and watch your own faith grow!',
    href: '/contact?topic=christian-education',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/Rectangle-25-1.jpg',
    description: `<p>Are you looking for a meaningful way to serve your church family? Our Sunday School program is growing, and we need passionate, loving volunteers to help our children learn about God's love. Whether you love teaching, helping with crafts, or simply being a friendly face, we have a place for you! You don't need a degree in education — just a willing heart to guide our kids.</p>
<p class="mt-3 font-semibold text-navy">Why Join the Team?</p>
<ul class="mt-1 space-y-1 list-none">
  <li><strong>Make a Difference:</strong> Help build a spiritual foundation for the youngest members of our congregation.</li>
  <li><strong>Build Community:</strong> Connect with other parents, volunteers, and the vibrant youth of our church.</li>
  <li><strong>Flexible Serving:</strong> We offer rotating schedules so you don't have to miss your own preferred worship service every week!</li>
</ul>
<p class="mt-3 font-semibold text-navy">Available Roles:</p>
<ul class="mt-1 space-y-1 list-none">
  <li><strong>Lead Teachers:</strong> Guide interactive Bible lessons (curriculum provided).</li>
  <li><strong>Assistant Helpers:</strong> Assist with games, crafts, and keeping the classroom organized.</li>
</ul>
<p class="mt-3">Ready to plant seeds of faith? Take a moment to browse the different roles and find your perfect fit.</p>`,
  },
  {
    dayNum: '30',
    dayName: 'Sun',
    month: 'AUG',
    title: 'Outdoor Worship',
    time: '11:30 AM',
    note: 'More details to come — mark your calendar!',
    href: '/contact?topic=outdoor-worship',
    location: 'Montgomery Fire House, Montgomery, NY',
    image: '/images/events-bg.jpg',
    description: '',
  },
  {
    dayNum: '13',
    dayName: 'Sun',
    month: 'SEP',
    title: 'Ready & Rooted! Brunch & Registration',
    time: '10:15 AM',
    note: 'Brunch & Registration for the upcoming Sunday School year — meet the teachers, mingle, and kids can enjoy time together!',
    href: '/contact?topic=ready-and-rooted',
    location: '137 Clinton Street, Montgomery, NY 12549',
    image: '/images/ready-and-rooted-sept13.jpg',
    description: '<p>Questions? Reach out to Laura at <a href="tel:8455424208" class="text-crimson hover:underline">845-542-4208</a>.</p>',
  },
];

const GALLERY_LARGE = '/images/Rectangle-54.jpg';
const GALLERY_SMALL = [
  '/images/Rectangle-55.jpg',
  '/images/Rectangle-71.jpg',
  '/images/Rectangle-72.jpg',
  '/images/Rectangle-55.jpg',
  '/images/Rectangle-71.jpg',
  '/images/Rectangle-72.jpg',
];
---

<BaseLayout title={title} description={description}>

  <!-- Hero -->
  <section
    class="relative flex items-center justify-center text-white text-center px-6 min-h-[520px] md:min-h-[600px]"
    style="background-image: linear-gradient(180deg, rgba(10,14,36,0.45) 0%, rgba(10,14,36,0.65) 100%), url('/images/events-bg.jpg'); background-size: cover; background-position: center 20%;"
  >
    <div class="relative max-w-3xl mx-auto py-12">
      <h1 class="display-xl text-white mb-6">Events &amp; Gallery</h1>
      <a href="/contact" class="btn btn-crimson">Contact Us</a>
    </div>
  </section>

  <!-- ============ EVENT CALENDAR ============ -->
  <section class="triangle-pattern py-20 md:py-24">
    <div class="max-w-container mx-auto px-6 lg:px-8">
      <div class="grid md:grid-cols-12 gap-10 items-start">

        <!-- Left: heading -->
        <div class="md:col-span-4">
          <p class="eyebrow-crimson mb-2">Stay Updated</p>
          <h2 class="display-xl">Event Calendar</h2>
        </div>

        <!-- Right: description + month + events -->
        <div class="md:col-span-8">
          <p class="font-mono text-[0.92rem] leading-relaxed text-ink-soft mb-8">
            Stay up to date with everything happening at First Presbyterian Church of Montgomery — from Sunday services and ministry gatherings to special events and community activities, our calendar keeps you connected to the life of our congregation.
          </p>

          <!-- Month badge -->
          <div class="flex items-center gap-3 mb-6">
            <span class="text-crimson">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </span>
            <h3 class="display-sm text-navy">June – September 2026</h3>
          </div>

          <!-- Event cards -->
          <div class="space-y-6">
            {EVENTS.map((ev) => (
              <div class="flex flex-col sm:flex-row gap-4 border border-navy/10 rounded-sm overflow-hidden bg-white shadow-sm">
                <!-- Date block -->
                <div class="flex-none flex flex-col items-center justify-center bg-navy text-white w-full sm:w-20 py-4 sm:py-6 px-4">
                  <span class="font-mono text-[0.6rem] tracking-widest uppercase text-white/70">{ev.month}</span>
                  <span class="text-3xl font-bold leading-none">{ev.dayNum}</span>
                  <span class="font-mono text-xs uppercase tracking-widest mt-1 text-white/80">{ev.dayName}</span>
                </div>

                <!-- Info -->
                <div class="flex-1 p-4 flex flex-col justify-center gap-1.5">
                  <h3 class="display-sm text-navy">
                    <a href={ev.href} class="hover:text-crimson transition-colors">{ev.title}</a>
                  </h3>
                  <p class="font-mono text-[0.8rem] text-crimson font-semibold">{ev.time}</p>
                  {ev.note && <p class="font-mono text-[0.78rem] text-ink-soft italic">{ev.note}</p>}
                  <p class="font-mono text-[0.78rem] text-ink-mute">{ev.location}</p>
                  {ev.description && (
                    <div class="font-mono text-[0.78rem] text-ink-soft leading-relaxed mt-2 space-y-1" set:html={ev.description} />
                  )}
                  <a href={ev.href} class="btn btn-crimson self-start text-sm py-1.5 px-4 mt-1">Learn More</a>
                </div>

                <!-- Image -->
                <div class="flex-none w-full sm:w-40 md:w-48 aspect-video sm:aspect-auto overflow-hidden">
                  <img
                    src={ev.image}
                    alt={ev.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ BECOME PART OF SOMETHING GREAT ============ -->
  <section class="bg-cream py-20 md:py-24">
    <div class="max-w-container mx-auto px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">

        <!-- Left: info -->
        <div>
          <h2 class="display-lg mb-3">Become Part of Something Great</h2>
          <p class="font-mono text-[0.92rem] text-ink-soft mb-8">Ready to Join? Fill out the Form! Or Contact Us Directly.</p>

          <ul class="space-y-5">
            <li class="flex items-start gap-4">
              <span class="mt-1 text-crimson flex-none">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <div class="font-mono text-[0.88rem] text-ink-soft leading-relaxed">
                First Presbyterian Church<br />
                {CHURCH.address.street}<br />
                {CHURCH.address.city}, {CHURCH.address.region} {CHURCH.address.postalCode}
              </div>
            </li>
            <li class="flex items-center gap-4">
              <span class="text-crimson flex-none">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <a href={`mailto:${CHURCH.email}`} class="font-mono text-[0.88rem] text-ink-soft hover:text-crimson transition-colors">
                {CHURCH.email}
              </a>
            </li>
            <li class="flex items-center gap-4">
              <span class="text-crimson flex-none">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17z"/>
                </svg>
              </span>
              <a href={`tel:${CHURCH.phoneLink}`} class="font-mono text-[0.88rem] text-ink-soft hover:text-crimson transition-colors">
                {CHURCH.phone}
              </a>
            </li>
          </ul>
        </div>

        <!-- Right: form -->
        <div>
          <ContactForm variant="cream" />
        </div>

      </div>
    </div>
  </section>

  <!-- ============ GALLERY HEADING ============ -->
  <section class="bg-white pt-16 pb-4">
    <div class="max-w-container mx-auto px-6 lg:px-8">
      <h2 class="display-lg">Gallery</h2>
    </div>
  </section>

  <!-- ============ GALLERY IMAGES ============ -->
  <section class="bg-white pb-16 md:pb-20">
    <div class="max-w-container mx-auto px-6 lg:px-8 space-y-4">

      <!-- Large full-width image -->
      <div class="w-full overflow-hidden">
        <img
          src={GALLERY_LARGE}
          alt="First Presbyterian Church congregation"
          class="w-full object-cover max-h-[420px]"
          loading="lazy"
        />
      </div>

      <!-- Row 1: 3 smaller images -->
      <div class="grid grid-cols-3 gap-4">
        {GALLERY_SMALL.slice(0, 3).map((src, i) => (
          <div class="overflow-hidden aspect-video">
            <img
              src={src}
              alt={`Church gallery photo ${i + 1}`}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- Row 2: 3 smaller images -->
      <div class="grid grid-cols-3 gap-4">
        {GALLERY_SMALL.slice(3).map((src, i) => (
          <div class="overflow-hidden aspect-video">
            <img
              src={src}
              alt={`Church gallery photo ${i + 4}`}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- Facebook share -->
      <div class="pt-2">
        <a
          href={`https://www.facebook.com/sharer.php?u=${encodeURIComponent(CHURCH.url + '/events-and-gallery/')}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 font-mono text-sm text-navy hover:text-crimson transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          Share on Facebook
        </a>
      </div>

    </div>
  </section>

  <GetNotified />

</BaseLayout>
