---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHURCH } from '../data/site';

const title = `Thank You | ${CHURCH.name}`;
const description = 'Thanks for reaching out — your message has been received.';
---

<BaseLayout title={title} description={description} noindex={true}>

  <section class="triangle-pattern py-32 md:py-44">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="mb-8 inline-flex items-center justify-center w-20 h-20 rounded-full bg-crimson text-white">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <p class="eyebrow mb-3">You're All Set</p>
      <h1 class="display-xl mb-6">Thank You!</h1>
      <p class="font-mono text-[0.95rem] leading-relaxed text-ink-soft mb-10 max-w-prose mx-auto">
        We've received your message and will get back to you as soon as we can. In the meantime, we'd love to see you on Sunday — worship begins at {CHURCH.service.time} at {CHURCH.address.street}, {CHURCH.address.city}.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn btn-crimson">Back to Home</a>
        <a href="/worship" class="btn border border-navy text-navy hover:bg-navy hover:text-white">About Sunday Worship</a>
      </div>
    </div>
  </section>
</BaseLayout>
