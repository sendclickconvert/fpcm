---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpcomingEvent from '../components/UpcomingEvent.astro';
import { CHURCH, HERO, PASTOR, STAFF } from '../data/site';
import { homepageSchema } from '../lib/seo';

const title = `First Presbyterian Church – Church Of Montgomery`;
const description = `${CHURCH.shortName} — Sunday worship at 10:00 AM. ${CHURCH.address.street}, ${CHURCH.address.city}, ${CHURCH.address.region}. All are welcome.`;

const YOUTUBE_ID = 'HJRzUQMhJMQ';

const infoBoxes = [
  {
    title: 'Inclusion Statement',
    image: '/images/inc-statement-1.webp',
    href: '/about',
  },
  {
    title: 'Supporting Families & Community',
    image: '/images/faith-1.webp',
    href: '/ministries',
  },
  {
    title: 'About Our Faith',
    image: '/images/faith-2.webp',
    href: '/about',
  },
];

const testimonials = [
  {
    quote: 'FPC has been my family for over 20 years. The warmth, the worship, and the community here are truly unlike anything I have ever experienced.',
    platform: '/images/google.png',
    photo: '/images/Margaret.png',
    name: 'Margaret T.',
    role: 'Congregation Member',
  },
  {
    quote: 'I walked in not knowing anyone and left feeling like I belonged. This church changed my life.',
    platform: '/images/facebook.png',
    photo: '/images/David.png',
    name: 'David R.',
    role: 'New Member',
  },
  {
    quote: 'The people here show up for each other in the most genuine way. FPC is not just a church — it is home.',
    platform: '/images/google.png',
    photo: '/images/sarah.png',
    name: 'Sarah L.',
    role: 'Youth Ministry Parent',
  },
];
---

<BaseLayout title={title} description={description} schema={homepageSchema()}>

  <!-- ============================================================
       1. HERO — full-bleed church exterior photo + left-aligned copy
       ============================================================ -->
  <section
    class="relative text-white"
    style={`background-image: linear-gradient(180deg, rgba(10,14,36,0.38) 0%, rgba(10,14,36,0.62) 100%), url('${HERO.bgImage}'); background-size: cover; background-position: center top;`}
  >
    <div class="max-w-container mx-auto px-8 lg:px-16 py-36 md:py-52 lg:py-64 flex flex-col items-start text-left max-w-2xl">
      <h1 class="display-xl text-white max-w-[13ch] mb-6 leading-[1.02]">{HERO.headline}</h1>
      <p class="font-mono text-sm md:text-base text-white/90 leading-relaxed mb-10 max-w-lg whitespace-pre-line">{HERO.body}</p>
      <a href={HERO.cta.href} class="btn btn-crimson">{HERO.cta.label}</a>
    </div>
  </section>

  <!-- ============================================================
       2. UPCOMING EVENT — crimson bar with date block + countdown
       ============================================================ -->
  <UpcomingEvent />

  <!-- ============================================================
       3. MESSAGE FROM THE PASTOR + FAITH IN ACTION
       ============================================================ -->
  <section
    class="relative text-white"
    style="background-image: linear-gradient(rgba(10,14,36,0.7), rgba(10,14,36,0.7)), url('/images/worship-bg.jpg'); background-size: cover; background-position: center;"
  >
    <div class="max-w-container mx-auto px-6 lg:px-8 py-20 md:py-28">

      <!-- Pastor message + portrait -->
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center mb-16">
        <!-- Left: copy -->
        <div>
          <p class="font-mono text-[0.72rem] tracking-[0.2em] uppercase text-white/70 mb-2">Message from</p>
          <h2 class="display-xl text-white mb-8">{PASTOR.heading}</h2>
          <blockquote class="font-mono text-[0.92rem] leading-relaxed text-white/90 mb-7 max-w-prose">
            {PASTOR.quote}
          </blockquote>
          <div class="border-l-2 border-white/40 pl-4">
            <a href="/im-new" class="font-mono text-sm text-white/80 hover:text-white transition-colors">
              <span class="mr-2 font-bold">|</span> {PASTOR.cta}
            </a>
          </div>
        </div>

        <!-- Right: portrait -->
        <div class="flex justify-center">
          <img
            src={PASTOR.avatar}
            alt="Message from the Pastor"
            class="w-full max-w-sm object-contain"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Walk in Faith on YouTube heading -->
      <div class="text-center mb-12">
        <h2 class="display-lg text-white mb-3">Walk in Faith with Us on YouTube</h2>
        <hr class="border-white/25 max-w-xs mx-auto mb-3" />
        <h3 class="font-mono text-[0.72rem] tracking-[0.2em] uppercase text-white/75">Faith in Action: Live Services, Events &amp; Teachings</h3>
      </div>

      <!-- 3 info boxes -->
      <div class="grid md:grid-cols-3 gap-6">
        {infoBoxes.map((box) => (
          <div
            class="relative overflow-hidden group"
            style={`background-image: linear-gradient(rgba(10,14,36,0.62), rgba(10,14,36,0.62)), url('${box.image}'); background-size: cover; background-position: center;`}
          >
            <div class="p-10 flex flex-col items-center text-center min-h-[200px] justify-center gap-6">
              <h3 class="display-md text-white">{box.title}</h3>
              <a href={box.href} class="btn btn-crimson text-sm px-6 py-3">Learn More</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       4. SUNDAY SERVICES LIVESTREAM — navy, YouTube embeds
       ============================================================ -->
  <section class="bg-navy text-white py-16 md:py-20">
    <div class="max-w-container mx-auto px-6 lg:px-8">

      <!-- Title row -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-10">
        <h2 class="display-lg text-white">Sunday Services Livestream</h2>
        <a href={`https://www.youtube.com/@fpcmontgomery`} target="_blank" rel="noopener" class="btn btn-crimson self-start md:self-auto">
          Watch More Here
        </a>
      </div>

      <!-- Two YouTube embeds side by side -->
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="aspect-video w-full">
          <iframe
            class="w-full h-full"
            src={`https://www.youtube.com/embed/${YOUTUBE_ID}?rel=0&controls=1&modestbranding=0`}
            title="First Presbyterian Church Sunday Service"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="aspect-video w-full">
          <iframe
            class="w-full h-full"
            src={`https://www.youtube.com/embed/${YOUTUBE_ID}?rel=0&controls=1&modestbranding=0`}
            title="First Presbyterian Church Sunday Service"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- Share row + Frame-32 photo -->
      <div class="flex flex-col md:flex-row items-center gap-8">
        <!-- Share buttons -->
        <div class="flex items-center gap-4">
          <a href={`https://www.facebook.com/sharer.php?u=${encodeURIComponent('https://fpcmontgomery.org/')}`} target="_blank" rel="noopener" aria-label="Share on Facebook"
            class="inline-flex items-center justify-center w-10 h-10 bg-[#1877F2] text-white hover:opacity-90 transition-opacity">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href={`https://twitter.com/share?url=${encodeURIComponent('https://fpcmontgomery.org/')}`} target="_blank" rel="noopener" aria-label="Share on X"
            class="inline-flex items-center justify-center w-10 h-10 bg-black text-white hover:opacity-90 transition-opacity">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.658l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231L18.244 2.25Z"/></svg>
          </a>
          <a href={`https://www.linkedin.com/shareArticle?url=${encodeURIComponent('https://fpcmontgomery.org/')}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"
            class="inline-flex items-center justify-center w-10 h-10 bg-[#0A66C2] text-white hover:opacity-90 transition-opacity">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          </a>
        </div>

        <!-- Frame-32 collage -->
        <div class="flex-1 flex justify-end">
          <img src="/images/Frame-32.png" alt="First Presbyterian Church community" class="max-h-48 w-auto object-contain" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. STAFF & LEADERSHIP — white section, 5 circles
       ============================================================ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-container mx-auto px-6 lg:px-8">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <h2 class="display-lg">Staff &amp; Leadership</h2>
        <a href="/about" class="btn btn-crimson self-start md:self-auto">Learn More About Us</a>
      </div>

      <hr class="border-rule mb-12" />

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 md:gap-6">
        {STAFF.map((person) => (
          <div class="flex flex-col items-center text-center">
            <div class="w-28 h-28 md:w-32 md:h-32 lg:w-36 lg:h-36 rounded-full overflow-hidden mb-4 border border-rule bg-cream">
              <img src={person.avatar} alt={`Photo of ${person.name}`} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="font-display text-lg md:text-xl text-ink leading-tight">{person.name}</p>
            <p class="font-mono text-[0.68rem] tracking-wider uppercase text-ink-mute mt-1">{person.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       6. LIFE AT FIRST PRESBYTERIAN — bg photo, links + explore copy
       ============================================================ -->
  <section
    class="relative text-white"
    style="background-image: linear-gradient(rgba(10,14,36,0.7), rgba(10,14,36,0.7)), url('/images/bg-ministries.jpg'); background-size: cover; background-position: center;"
  >
    <div class="max-w-container mx-auto px-6 lg:px-8 py-20 md:py-28 grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Left: category links -->
      <div class="flex flex-col gap-8">
        {[
          { label: 'Ministries', href: '/ministries' },
          { label: 'Worship', href: '/worship' },
          { label: 'Events & Gallery', href: '/events' },
          { label: 'Giving', href: '/giving' },
        ].map((cat) => (
          <div class="border-b border-white/20 pb-6 last:border-0 last:pb-0">
            <h3 class="display-md text-white mb-3">{cat.label}</h3>
            <a href={cat.href} class="btn btn-crimson">Learn More</a>
          </div>
        ))}
      </div>

      <!-- Right: Explore More copy -->
      <div>
        <p class="font-mono text-[0.72rem] tracking-[0.2em] uppercase text-white/70 mb-3">Explore More</p>
        <h2 class="display-xl text-white mb-6">Life at First Presbyterian</h2>
        <p class="font-mono text-[0.9rem] leading-relaxed text-white/85 mb-8 max-w-prose">
          Everything you need to worship, connect, serve, and grow — all in one place.
        </p>
        <a href="/events" class="btn btn-crimson">Learn More</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       7. REVIEWS — white section, featured quote + portrait
       ============================================================ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-container mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- Left: heading + quote -->
      <div>
        <h2 class="display-lg mb-6">
          <span class="text-[#D4A642] mr-2">•</span> Reviews
        </h2>
        <blockquote class="font-mono text-[0.95rem] leading-relaxed text-ink-soft mb-6 max-w-prose">
          "From the moment I walked through the doors, I felt welcomed and at home. The messages are powerful and rooted in the Word, and the community is genuinely loving and supportive."
        </blockquote>
        <img src="/images/unnamed-file.png" alt="5 star rating" class="h-8 w-auto" loading="lazy" />
      </div>

      <!-- Right: portrait photo -->
      <div>
        <img
          src="/images/Component-11.jpg"
          alt="Member of First Presbyterian Church of Montgomery"
          class="w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ============================================================
       8. TESTIMONIAL CARDS — 3 community testimonials
       ============================================================ -->
  <section class="bg-cream py-16 md:py-20">
    <div class="max-w-container mx-auto px-6 lg:px-8 grid md:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <div class="bg-white shadow-sm p-6 flex flex-col gap-5">
          <!-- Quote bubble -->
          <div class="bg-cream p-5 relative flex-1">
            <span class="font-display text-5xl text-crimson leading-none absolute top-2 left-4 select-none">"</span>
            <p class="font-mono text-[0.85rem] leading-relaxed text-ink-soft pt-7">{t.quote}</p>
            <img src={t.platform} alt="" class="h-5 w-auto mt-4 ml-auto" loading="lazy" />
          </div>
          <!-- Author -->
          <div class="flex items-center gap-4">
            <img src={t.photo} alt={t.name} class="w-12 h-12 rounded-full object-cover" loading="lazy" />
            <div>
              <p class="font-display text-lg leading-tight text-ink">{t.name}</p>
              <p class="font-mono text-[0.68rem] uppercase tracking-wider text-ink-mute">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
