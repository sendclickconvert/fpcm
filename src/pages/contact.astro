---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GetNotified from '../components/GetNotified.astro';
import ContactForm from '../components/ContactForm.astro';
import { CHURCH } from '../data/site';

const title = `Contact | ${CHURCH.name}`;
const description = `Contact First Presbyterian Church of Montgomery. 137 Clinton Street, Montgomery, NY 12549. Office hours ${CHURCH.hours}. ${CHURCH.phone}.`;

// Pull topic from query string for prefilling (handled server-side).
const topic = Astro.url.searchParams.get('topic') ?? undefined;
---

<BaseLayout title={title} description={description}>

  <PageHero
    title="Contact"
    image="/images/contact-hero.jpg"
    size="lg"
  />

  <!-- ============ INFO + CHURCH INFORMATION ============ -->
  <section class="triangle-pattern py-20 md:py-28">
    <div class="max-w-container mx-auto px-6 lg:px-8 grid md:grid-cols-12 gap-12">

      <!-- Left -->
      <div class="md:col-span-6">
        <h2 class="display-xl mb-5">We'd love to hear<br />from you</h2>
        <p class="font-mono text-[0.92rem] leading-relaxed text-ink-soft max-w-prose">
          For general enquiries, please complete our contact form and we will get to you as soon as possible.
        </p>
      </div>

      <!-- Right: contact details + church information -->
      <div class="md:col-span-6 space-y-8">

        <ul class="space-y-5 font-mono text-[0.88rem]">
          <li class="flex items-start gap-3">
            <span class="text-crimson mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span class="uppercase tracking-wider text-ink">{CHURCH.address.street}, {CHURCH.address.city},<br />{CHURCH.address.region} {CHURCH.address.postalCode}</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-crimson mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <a href={`mailto:${CHURCH.email}`} class="uppercase tracking-wider text-ink hover:text-crimson break-all transition-colors">{CHURCH.email}</a>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-crimson mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <a href={`tel:${CHURCH.phoneLink}`} class="text-ink hover:text-crimson transition-colors">{CHURCH.phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-crimson mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
            </span>
            <span class="text-ink">{CHURCH.hours} <span class="text-ink-mute">({CHURCH.hoursDays})</span></span>
          </li>
        </ul>

        <hr class="border-rule" />

        <div>
          <h3 class="display-md mb-4">Church Information</h3>
          <dl class="font-mono text-[0.82rem] space-y-2">
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Name:</dt><dd class="text-ink uppercase">First Presbyterian Church</dd></div>
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Presbytery:</dt><dd class="text-ink uppercase">{CHURCH.presbytery}</dd></div>
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Synod:</dt><dd class="text-ink uppercase">{CHURCH.synod}</dd></div>
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Congregation Size:</dt><dd class="text-ink uppercase">{CHURCH.congregationSize}</dd></div>
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Worship Attendance:</dt><dd class="text-ink uppercase">{CHURCH.worshipAttendance}</dd></div>
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Church School Attendance:</dt><dd class="text-ink uppercase">{CHURCH.churchSchoolAttendance}</dd></div>
            <div class="flex flex-wrap gap-x-2"><dt class="text-crimson uppercase tracking-wider">Community Type:</dt><dd class="text-ink uppercase">{CHURCH.communityType}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FORM (navy section, white card) ============ -->
  <section class="bg-navy text-white py-20 md:py-24">
    <div class="max-w-container mx-auto px-6 lg:px-8">
      <p class="font-mono text-sm text-white/85 text-center max-w-2xl mx-auto mb-10">
        Please fill out the form below, and we'll get back to you as soon as possible.
        We look forward to connecting with you!
      </p>
      <ContactForm variant="navy" topic={topic} />
    </div>
  </section>

  <GetNotified />
</BaseLayout>
